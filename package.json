{
  "name": "stocky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=dev bun src/server/index.ts",
    "build": "bun run scripts/build.ts",
    "build:tailwind": "bunx @tailwindcss/cli -i ./src/client/style.css -o ./src/client/output.css",
    "compile": "NODE_ENV=build bun build:tailwind && bun build --compile --target=bun --outfile=stocky src/server/index.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@heroicons/react": "^2.2.0",
    "idb-keyval": "^6.3.0",
    "jotai": "^2.20.2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "daisyui": "5.7.4",
    "tailwindcss": "^4.3.3"
  }
}